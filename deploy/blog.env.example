# 复制到 /etc/blog/blog.env 并填入真实密钥
# 文件权限必须 600，chown root:root
# 用法： cp deploy/blog.env.example /etc/blog/blog.env

# Flask session 加密密钥（必须，48+ 字符随机串）
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BLOG_SECRET_KEY=change-me-to-a-long-random-string-at-least-48-chars

# 可选：Sentry / 错误监控 DSN
# SENTRY_DSN=

# 可选：自定义日志级别
# LOG_LEVEL=INFO
